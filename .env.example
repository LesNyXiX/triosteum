# Скопируйте в .env и поменяйте пароли. Файл .env в Git не попадает.
DB_OWNER_PASSWORD=поменяйте-меня-владелец
APP_DB_PASSWORD=поменяйте-меня-приложение
# 1 — cookie только по HTTPS (в продакшене обязательно). Для проверки на своём компьютере по http: 0
COOKIE_SECURE=0
# 1 — сервер стоит за своим nginx/caddy и доверяет X-Forwarded-For
TRUST_PROXY=0
PORT=8000
