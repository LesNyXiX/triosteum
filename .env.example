# Скопируйте в .env и поменяйте пароли. Файл .env в Git не попадает.
DB_OWNER_PASSWORD=поменяйте-меня-владелец
APP_DB_PASSWORD=поменяйте-меня-приложение
# секрет между сервером и исполнителем Python-блоков — любая длинная случайная строка
RUNNER_TOKEN=поменяйте-меня-исполнитель
# 1 — cookie только по HTTPS (в продакшене обязательно). Для проверки на своём компьютере по http: 0
COOKIE_SECURE=0
# 1 — сервер стоит за своим nginx/caddy и доверяет X-Forwarded-For
TRUST_PROXY=0
# регистрация новых организаций: invite — только по приглашению администратора (по умолчанию), open — любой желающий.
# Администратор меняет её в «Панели администратора»; эта строка — только начальное значение. Первый зарегистрированный — администратор.
REGISTRATION=invite
PORT=8000

# ---- ИИ (необязательно) ----
# своя модель: AI_PROVIDER=openai, AI_MODEL=qwen2.5-coder:14b (запуск: docker compose --profile ai up -d)
# YandexGPT:   AI_PROVIDER=yandex, YANDEX_API_KEY=..., YANDEX_FOLDER_ID=b1g..., AI_MODEL=yandexgpt
AI_PROVIDER=
AI_MODEL=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# ---- Почта (необязательно): приглашения письмом и «Забыли пароль?» ----
# Бесплатно: ящик на Яндексе → Настройки → Безопасность → Пароли приложений → «Почта».
# PUBLIC_URL — адрес Triosteum, на который будут вести ссылки в письмах.
PUBLIC_URL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# ---- Боевой сервер (заполняет deploy/install.sh) ----
DOMAIN=
ACME_EMAIL=
# адреса образов, если Docker Hub и зеркало недоступны
# POSTGRES_IMAGE=postgres:16
# PYTHON_IMAGE=python:3.12-slim
# CADDY_IMAGE=caddy:2
