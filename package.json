{
  "name": "triosteum",
  "version": "0.1.0",
  "private": true,
  "description": "Triosteum — экосистема для производств: доска блоков кода и офисная среда",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "test": "node tests/merge.test.cjs && node tests/formulas.test.cjs && node tests/foreign.test.cjs && node tests/lang-corpus.test.cjs && node tests/highlight.test.cjs && node tests/plugins.test.cjs && node tests/smoke.mjs",
    "serve:mock": "node tests/mock-server.mjs",
    "test:server": "node tests/server-e2e.mjs",
    "test:envs": "node tests/envs-e2e.mjs",
    "test:office": "node tests/office-map-e2e.mjs",
    "test:graphics": "node tests/graphics-e2e.mjs",
    "test:universal": "node tests/universal-e2e.mjs",
    "test:board": "node tests/board-e2e.mjs",
    "test:compiler": "node tests/compiler-e2e.mjs",
    "test:docks": "node tests/docks-themes-e2e.mjs",
    "test:cross": "node tests/cross-find.test.cjs && node tests/cross-e2e.mjs",
    "test:snap": "node tests/snap-e2e.mjs",
    "test:storage": "node tests/storage-e2e.mjs",
    "test:tour": "node tests/tour-e2e.mjs",
    "test:trash": "node tests/trash-e2e.mjs",
    "test:split": "node tests/split-e2e.mjs",
    "test:a11y": "node tests/a11y-e2e.mjs",
    "test:library": "node tests/library-e2e.mjs",
    "test:envdock": "node tests/dock-morph-e2e.mjs && node tests/envdock-e2e.mjs",
    "test:errai": "node tests/err-ai-e2e.mjs",
    "test:touch": "node tests/touch-stem-e2e.mjs",
    "test:arc": "node tests/arc-ai-e2e.mjs",
    "test:groups": "node tests/groups-e2e.mjs",
    "test:runhist": "node tests/run-history-e2e.mjs",
    "test:dataflow": "node tests/data-flow-e2e.mjs",
    "test:whatsnew": "node tests/whats-new-e2e.mjs",
    "test:audit": "node tests/audit.test.cjs && node tests/audit-e2e.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.48.0"
  }
}
